<Dialog Title="Emulator help" Visible="Visible" VisibleChanged="VisibleChanged">
    <hr/>

    <h3>Wozmon (the <code>\</code> prompt)</h3>
    <ul>
        <li><code>E000R</code> starts Integer BASIC.</li>
        <li><code>FF00</code> shows the byte stored at that address.</li>
        <li><code>FF00.FF0F</code> shows a range of bytes.</li>
        <li><code>280: A9 00 60</code> stores bytes starting at address <code>0280</code>.</li>
        <li><code>280R</code> runs the program at that address.</li>
        <li>Press <code>Esc</code> to cancel the line you're typing.</li>
    </ul>

    <h3>Integer BASIC (the <code>&gt;</code> prompt)</h3>
    <ul>
        <li>Every program line needs a line number, e.g.: <code>10 PRINT "HELLO"</code>.</li>
        <li>A line without a number runs immediately.</li>
        <li>End programs with <code>END</code>.</li>
        <li><code>RUN</code> starts the program, <code>LIST</code> shows it, and <code>SCR</code> clears it.</li>
    </ul>
</Dialog>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
}