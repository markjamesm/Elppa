@using Elppa.Core
@implements IDisposable

<div class="monitor" @onclick="FocusAsync">
    <img class="bezel" src="images/crt.png" alt="Photo of a CRT monitor"/>

    <div class="terminal">
        <pre>@_text</pre>
    </div>

    <input class="keyboard-capture" @ref="_input"
           type="text" aria-label="Apple I keyboard"
           autocomplete="off" autocapitalize="characters" spellcheck="false" autocorrect="off"
           @onkeydown="OnDesktopKeyDown" @onkeydown:preventDefault
           @bind:event="oninput"
           @bind:get="_inputValue"
           @bind:set="OnMobileInput"/>
</div>

@code {

    // The input always holds this one invisible character. If it disappears,
    // that was a Backspace on a phone keyboard that doesn't report key events.
    private const string Sentinel = "\u200B";

    private readonly WebTerminal _screenBuffer = new();
    private readonly CancellationTokenSource _cts = new();
    private readonly Emulator _emulator;
    private ElementReference _input;
    private string _inputValue = Sentinel;
    private string _text = "";

    public Terminal()
    {
        _emulator = new Emulator(_screenBuffer);   
    }

    // Lets the parent hand the keyboard back after a dialog closes.
    public async Task FocusAsync() => await _input.FocusAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }
        
        await _input.FocusAsync();

        _ = RunAsync(_cts.Token);
    }

    private async Task RunAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(16));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                _emulator.RunFrame();

                if (_screenBuffer.IsDirty)
                {
                    _text = _screenBuffer.Render();
                    StateHasChanged();
                }
            }
        }
        catch (OperationCanceledException)
        {
            // DisposeAsync cancels the token to stop the loop.
        }
    }

    // Desktop keyboards, and phone keyboards that report real keys.
    // preventDefault stops the character from also arriving in OnMobileInput.
    private void OnDesktopKeyDown(KeyboardEventArgs e)
    {
        if (e.CtrlKey || e.MetaKey || e.AltKey)
        {
            return;
        }

        if (ToChar(e.Key) is { } ch)
        {
            _emulator.SendKey(ch);
        }
    }

    // Phone keyboards that report the key as "Unidentified" arrive here instead.
    private void OnMobileInput(string value)
    {
        if (value.Length == 0)
        {
            _emulator.SendKey('\b');
        }

        else
        {
            foreach (var ch in value.Replace(Sentinel, ""))
            {
                _emulator.SendKey(ch);
            }
        }

        _inputValue = Sentinel;
    }

    private static char? ToChar(string key) => key switch
    {
        "Enter" => '\r',
        "Backspace" => '\b',
        "Escape" => '\x1B',
        { Length: 1 } => key[0],
        _ => null
    };

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }

}