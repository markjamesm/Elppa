@page "/"
@using Elppa.Blazor.Components
@using Elppa.Blazor.Components.Dialogs
@inject HttpClient Http

<PageTitle>Elppa - Apple I Emulator</PageTitle>

<Terminal @ref="_terminal"/>

<MenuBar OnAbout="() => _modal = Modal.About"
         OnHelp="() => _modal = Modal.Help"
         OnLoadProgram="() => _modal = Modal.LoadProgram"
         OnRunSoftware="RunSoftware"
         OnReset="Reset"/>

<HelpDialog Visible="_modal == Modal.Help" VisibleChanged="OnModalVisibleChanged"/>
<AboutDialog Visible="_modal == Modal.About" VisibleChanged="OnModalVisibleChanged"/>
<ExecuteProgramDialog Visible="_modal == Modal.LoadProgram"
                      VisibleChanged="OnModalVisibleChanged"
                      OnRun="text => _terminal.LoadProgramFromText(text)"/>


@code {

    private enum Modal
    {
        None,
        Help,
        About,
        LoadProgram
    }

    private Terminal _terminal = default!;
    private Modal _modal = Modal.None;

    private async Task OnModalVisibleChanged(bool visible)
    {
        if (visible)
        {
            return;
        }

        _modal = Modal.None; // Only one modal is ever open.
        await _terminal.FocusAsync();
    }
    
    private async Task RunSoftware(string file)
    {
        var text = await Http.GetStringAsync($"programs/{file}");
        _terminal.ResetEmulator();
        _terminal.LoadProgramFromText(text);
        await _terminal.FocusAsync();
    }

    private async Task Reset()
    {
        _terminal.ResetEmulator();
        await _terminal.FocusAsync();
    }

}